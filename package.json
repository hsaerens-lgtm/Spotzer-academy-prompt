    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "leva": "0.10.1",
    "meshoptimizer": "1.2.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
