    "gpt-tokenizer": "4.0.0",
    "i18next": "26.4.2",
    "maath": "0.10.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "three": "0.186.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
