# Copy this file to .env.local and fill in the values. .env.local is never committed.
# Without OPENAI_API_KEY the corrector shows as offline; everything else works.
OPENAI_API_KEY=
# gpt-5.4-nano is the cheapest current model; gpt-5-mini grades more carefully.
OPENAI_MODEL=gpt-5.4-nano
# OPENAI_REASONING_EFFORT=low
PORT=8787
RATE_PER_MINUTE=10
RATE_PER_DAY=100
GLOBAL_PER_DAY=1000
MAX_OUTPUT_TOKENS_CORRECT=4000
MAX_OUTPUT_TOKENS_RUN=1500
OPENAI_TIMEOUT_MS=30000
# Address to listen on. Unset: every interface (production). "npm run dev" always uses 127.0.0.1.
# HOST=127.0.0.1
# Only behind exactly one reverse-proxy hop, which must append to X-Forwarded-For and preserve the Host header
# (the same-origin check compares Origin with Host). With any other setup, leave it unset.
# TRUST_PROXY=1
